# ──────────────────────────────────────────────────────────────────────────────
# GitHub Certified: Agentic AI Developer — study app environment variables
#
# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI (required for exam generation) ────────────────────────────────────
OPENAI_API_KEY=sk-...

# Model used for question generation batches.
# Recommended: gpt-5.5 or o4-mini for best quality.
OPENAI_MODEL=gpt-5.5

# Reasoning effort for the generation pass (low | medium | high).
OPENAI_REASONING_EFFORT=medium

# Reasoning effort for the review/anti-bias pass.
OPENAI_REVIEW_REASONING_EFFORT=high

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3000).
PORT=3000

# Set to "production" to hide dev-only features (generate panel, publish
# toggle, PDF generate/download buttons).  Omit or set to "development" locally.
NODE_ENV=development

# ── Google Cloud Storage (optional) ──────────────────────────────────────────
# Name of the GCS bucket where generated PDFs are uploaded.
# When set, PDFs are uploaded after generation and served via the public GCS URL
# (https://storage.googleapis.com/<bucket>/<filename>).
# When unset, PDFs are served from the local data/exams/ directory (dev only).
#
# Bucket setup:
#   1. Create a bucket: gcloud storage buckets create gs://YOUR_BUCKET --location=us-central1
#   2. Allow public reads: gcloud storage buckets add-iam-policy-binding gs://YOUR_BUCKET \
#        --member=allUsers --role=roles/storage.objectViewer
#   3. On Cloud Run the service account needs roles/storage.objectAdmin on the bucket.
#   4. Locally, run: gcloud auth application-default login
#
GCS_BUCKET=
